{
  "name": "@marcus/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Marcus Agentic OS agents",
  "license": "Apache-2.0",
  "keywords": ["ai", "agents", "agentic", "bun", "typescript", "marcus"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stock42/marcus.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://projectmarcus.com/documentacion/sdk",
  "bugs": {
    "url": "https://github.com/stock42/marcus/issues"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE", "NOTICE"],
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@types/bun": ">=1.3.14 <2"
  },
  "devDependencies": {
    "@marcus/contracts": "workspace:*",
    "@marcus/schema": "workspace:*"
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "bun test ./src",
    "pack": "bun run scripts/pack.ts"
  }
}
