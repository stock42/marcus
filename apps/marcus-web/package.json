{
  "name": "@marcus/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun --bun next build",
    "dev": "bun --bun next dev --hostname 127.0.0.1 --port ${MARCUS_WEB_PORT:-4321}",
    "start": "bun --bun next start --hostname 127.0.0.1 --port ${MARCUS_WEB_PORT:-4321}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@marcus/contracts": "workspace:*",
    "@marcus/studio-contracts": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@marcus/cli": "workspace:*",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
